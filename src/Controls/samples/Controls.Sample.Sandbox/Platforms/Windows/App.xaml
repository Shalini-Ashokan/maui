<maui:MauiWinUIApplication
    xmlns:controls="using:Microsoft.Maui.Controls"
    x:Class="Maui.Controls.Sample.Platform.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="using:Microsoft.Maui"
    xmlns:local="using:Maui.Controls.Sample.Platform"
    xmlns:platform="using:Microsoft.Maui.Platform">
    <maui:MauiWinUIApplication.Resources>
        <controls:ResourceDictionary>
            <!-- App-level entries take precedence over MAUI's merged resource dictionaries.
                 This old app-owned template intentionally has no activation visual states.
                 Reuse MAUI's selectors and default title data templates unchanged. -->
            <controls:Style TargetType="platform:WindowRootView">
                <controls:Setter Property="Template">
                    <controls:Setter.Value>
                        <controls:ControlTemplate TargetType="platform:WindowRootView">
                            <controls:Page Margin="0"
                                    Padding="0"
                                    x:Name="RootPage">
                                <controls:Page.Resources>
                                    <!-- Keep the default NavigationView header/content layout. -->
                                    <maui:Thickness x:Key="NavigationViewMinimalHeaderMargin">0,0,0,0</maui:Thickness>
                                    <maui:Thickness x:Key="NavigationViewHeaderMargin">0,0,0,0</maui:Thickness>
                                    <maui:Thickness x:Key="NavigationViewMinimalContentGridBorderThickness">0,0,0,0</maui:Thickness>
                                    <maui:Thickness x:Key="TopNavigationViewTopNavGridMargin">4,0,0,0</maui:Thickness>
                                    <maui:Thickness x:Key="NavigationViewContentGridBorderThickness">0,0,0,0</maui:Thickness>
                                    <maui:Thickness x:Key="TopNavigationViewContentGridBorderThickness">0,0,0,0</maui:Thickness>
                                    <maui:CornerRadius x:Key="NavigationViewContentGridCornerRadius">0,0,0,0</maui:CornerRadius>
                                    <maui:Thickness x:Key="NavigationViewItemContentPresenterMargin">0,0,0,0</maui:Thickness>
                                </controls:Page.Resources>
                                <controls:Grid x:Name="RootGrid"
                                        RowSpacing="0"
                                        ColumnSpacing="0"
                                        Margin="0"
                                        Padding="0">
                                    <ContentControl x:Name="AppTitleBarContainer"
                                                    IsTabStop="False"
                                                    VerticalAlignment="Top"
                                                    VerticalContentAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Canvas.ZIndex="1"
                                                    Margin="{TemplateBinding WindowTitleBarContainerMargin}"
                                                    DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                    ContentTemplateSelector="{StaticResource MauiAppTitleBarContainerTemplateSelector}">
                                    </ContentControl>
                                    <controls:ContentPresenter Canvas.ZIndex="0"></controls:ContentPresenter>
                                </controls:Grid>
                            </controls:Page>
                        </controls:ControlTemplate>
                    </controls:Setter.Value>
                </controls:Setter>
            </controls:Style>
        </controls:ResourceDictionary>
    </maui:MauiWinUIApplication.Resources>
</maui:MauiWinUIApplication>

